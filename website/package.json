{
  "name": "tcsexam-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node tools/check-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && node tools/export-lite-results.mjs && node tools/export-full-index.mjs && vite build && node tools/export-task-pages.mjs && node tools/prepare-public-release.mjs",
    "build:pages": "node tools/build-pages.mjs",
    "build:site": "node tools/build-site.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "katex": "0.19.0",
    "marked": "15.0.12",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.64.0"
  }
}
