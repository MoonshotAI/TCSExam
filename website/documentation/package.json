{
  "name": "tcsexam-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "npm run generate && vitepress dev .",
    "build": "npm run generate && vitepress build . && node scripts/check-built.mjs && node scripts/vendor-notices.mjs",
    "preview": "vitepress preview .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.0.2",
    "minisearch": "7.1.2",
    "vitepress": "1.6.4",
    "vue": "3.5.30"
  }
}
