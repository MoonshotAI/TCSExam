/-!
# Quantum stabilizer codes [[25,7]] — fixed definition layer

A **quantum stabilizer code** `[[25,7,d]]` encodes 7 logical qubits into 25
physical qubits with minimum distance `d`. It is presented by `25 − 7 = 18`
independent, pairwise-commuting **stabilizer generators**, each a 25-letter
Pauli operator over `{I,X,Y,Z}` with phases dropped (an independent
pairwise-commuting set lifts to an abelian stabilizer group not containing
`−I` by taking all phases `+1`, so independence + pairwise commutation
suffices — phases are never needed).

**Distance semantics (standard; the calibration fact of this task).** The
distance is the minimum weight of `N(S) ∖ S`: the lightest Pauli operator
that commutes with every generator but is **not itself in the generated
group `S`** (weight = number of non-`I` positions). `S` may itself contain
low-weight elements — such codes are called **degenerate**, and the
published record code `[[25,7,5]]` is one of them (it has weight-1 elements
inside `S`, coming from its 4 pinned extension qubits). Measuring the
lightest commuting Pauli *without* the membership test reads `d = 1` on the
record code; the correct reading is `d = 5`.

Everything from the top of this file down to the line
`-- END OF FIXED PART` is part of the problem statement. The judge checks
it verbatim; do not edit, move, or delete it. Your work (auxiliary
definitions, lemmas, your generator table, and the proof of the claim)
goes below the mark.

**Computational layout.** Certificates use `Pauli25` (two `BitVec 25`
masks). The checks convert the 18 generators once to machine words
(`UInt64`; a Pauli key `x | z ≪ 25` is 50 bits, so this is exact) and run
the weight sweep on words: per candidate, commutation against the 18
generators with early exit, survivors are membership-tested against the
sorted 2¹⁸-element group by binary search. `native_decide` compiles all of
this to native code; kernel-side `decide` is far too slow at this scale.
-/

/-- A Pauli operator on 25 qubits in phase-free `(x|z)` binary form:
`x` and `z` are the X- and Z-part bitmasks over the 25 positions, so the
letter at position `i` is `I = (0,0)`, `X = (1,0)`, `Z = (0,1)`,
`Y = (1,1)`. Position `i` of the 25-letter string is bit `i`. -/
structure Pauli25 where
  x : BitVec 25
  z : BitVec 25
  deriving Inhabited

/-- The 50-bit key of a Pauli, `x | z ≪ 25`, as a machine word
(50 bits fit into `UInt64`; used for group membership). -/
def pauliKey (p : Pauli25) : UInt64 :=
  p.x.toNat.toUInt64 ||| (p.z.toNat.toUInt64 <<< (25 : UInt64))

/-- Parity of the popcount of a machine word (fold-xor). -/
def bitPar (v : UInt64) : Bool :=
  let v := v ^^^ (v >>> (32 : UInt64))
  let v := v ^^^ (v >>> (16 : UInt64))
  let v := v ^^^ (v >>> (8 : UInt64))
  let v := v ^^^ (v >>> (4 : UInt64))
  let v := v ^^^ (v >>> (2 : UInt64))
  let v := v ^^^ (v >>> (1 : UInt64))
  (v &&& (1 : UInt64)) == (1 : UInt64)

/-- Symplectic commutation: `p` and `q` commute iff
`popcount((x_p ∧ z_q) ⊕ (z_p ∧ x_q))` is even. -/
def commPauli (p q : Pauli25) : Bool :=
  !bitPar ((p.x.toNat.toUInt64 &&& q.z.toNat.toUInt64) ^^^
           (p.z.toNat.toUInt64 &&& q.x.toNat.toUInt64))

/-- GF(2) rank of a list of 50-bit rows (packed `x | z ≪ 25`), by Gaussian
elimination. -/
def gf2Rank (rows : List Nat) : Nat := Id.run do
  let mut a := rows.toArray
  let mut rk := 0
  for h in (List.range 50).reverse do
    let mut sel : Option Nat := none
    for i in [rk : a.size] do
      if ((a[i]! >>> h) &&& 1) == 1 then
        sel := some i
        break
    if let some i := sel then
      let pivot := a[i]!
      a := a.set! i a[rk]!
      a := a.set! rk pivot
      for j in [0 : a.size] do
        if j != rk && (((a[j]! >>> h) &&& 1) == 1) then
          a := a.set! j (a[j]! ^^^ pivot)
      rk := rk + 1
  return rk

/-- The stabilizer premises on 18 generators: every pair commutes and the
GF(2) rank is exactly 18 (rank 18 on 25 qubits ⇔ k = 7). -/
def isStab (gens : Fin 18 → Pauli25) : Bool :=
  (List.finRange 18).all (fun i =>
    (List.finRange 18).all (fun j => commPauli (gens i) (gens j)))
  && gf2Rank ((List.finRange 18).map fun i =>
       (gens i).x.toNat ||| ((gens i).z.toNat <<< 25)) == 18

/-- The full stabilizer group `S` generated by `gens`, as a sorted array of
50-bit keys (2¹⁸ = 262144 elements when the generators are independent). -/
def enumGroup (gens : Fin 18 → Pauli25) : Array UInt64 := Id.run do
  let mut keys : Array UInt64 := #[(0 : UInt64)]
  for i in List.finRange 18 do
    let g := pauliKey (gens i)
    let mut nxt : Array UInt64 := Array.mkEmpty (2 * keys.size)
    for k in keys do
      nxt := nxt.push k
      nxt := nxt.push (k ^^^ g)
    keys := nxt
  return keys.qsort fun a b => decide (a < b)

/-- Binary search in a sorted array of keys. -/
def binMem (arr : Array UInt64) (k : UInt64) : Bool :=
  go 0 arr.size (64 : Nat)
where
  go (lo hi : Nat) : Nat → Bool
    | 0 => false
    | fuel + 1 =>
      if lo ≥ hi then false
      else
        let mid := (lo + hi) / 2
        let v := arr[mid]!
        if v == k then true
        else if v < k then go (mid + 1) hi fuel
        else go lo mid fuel

/-- Commutation of the candidate `(x,z)` (word form) with all 18
generators (precomputed as word pairs), with early exit. -/
def commAll (gx gz : Array UInt64) (x z : UInt64) : Bool :=
  go 18
where
  go : Nat → Bool
    | 0 => true
    | i + 1 =>
      !bitPar ((x &&& gz[i]!) ^^^ (z &&& gx[i]!)) && go i

/-- The distance predicate at one candidate: if it commutes with all
generators it must lie in `S` (otherwise it witnesses distance at most its
weight). -/
def checkCand (gx gz sorted : Array UInt64) (x z : UInt64) : Bool :=
  if commAll gx gz x z then
    binMem sorted (x ||| (z <<< (25 : UInt64)))
  else true

/-- Enumerate all Paulis of weight `left` built on positions `pos, …, 24`
(accumulated as `x|z` words) and run `checkCand` on each; returns `false`
at the first counterexample. `fuel` bounds the recursion depth: every level
advances `pos`, so 26 > 25 always suffices (the `fuel = 0` exit is only
reached with `pos = 25`, where no candidate remains). -/
def sweepW (gx gz sorted : Array UInt64) :
    Nat → Nat → Nat → UInt64 → UInt64 → Bool
  | 0, _, _, _, _ => true
  | fuel + 1, pos, left, x, z =>
    if left == 0 then
      checkCand gx gz sorted x z
    else if pos ≥ 25 ∨ 25 - pos < left then
      true
    else
      let b : UInt64 := (1 : UInt64) <<< pos.toUInt64
      (sweepW gx gz sorted fuel (pos + 1) (left - 1) (x ||| b) z
        && sweepW gx gz sorted fuel (pos + 1) (left - 1) (x ||| b) (z ||| b)
        && sweepW gx gz sorted fuel (pos + 1) (left - 1) x (z ||| b))
      && sweepW gx gz sorted fuel (pos + 1) left x z

/-- Computable certificate "the stabilizer code generated by `gens` has
distance ≥ d": every Pauli of weight `< d` that commutes with all 18
generators lies in the group `S` (swept exhaustively over weights
`1, …, d−1`). This is the `N(S) ∖ S` semantics: commuting candidates are
tested for membership in `S`, not merely counted. -/
def checkDistGE (gens : Fin 18 → Pauli25) (d : Nat) : Bool := Id.run do
  let gx : Array UInt64 :=
    ((List.finRange 18).map fun i => (gens i).x.toNat.toUInt64).toArray
  let gz : Array UInt64 :=
    ((List.finRange 18).map fun i => (gens i).z.toNat.toUInt64).toArray
  let sorted := enumGroup gens
  for w in [1 : d] do
    if !(sweepW gx gz sorted 26 0 w (0 : UInt64) (0 : UInt64)) then
      return false
  return true

/-- `IsStabilizer gens`: the 18 generators pairwise commute and are
GF(2)-independent (rank 18 ⇔ k = 7 on 25 qubits). Packaged as a
proposition so that `native_decide` checks concrete witnesses directly. -/
@[reducible]
def IsStabilizer (gens : Fin 18 → Pauli25) : Prop := isStab gens = true

/-- `DistanceGE gens d`: the code generated by `gens` has distance at
least `d`, i.e. the minimum weight of `N(S) ∖ S` is `≥ d`. Packaged as a
proposition so that `native_decide` checks concrete witnesses directly. -/
@[reducible]
def DistanceGE (gens : Fin 18 → Pauli25) (d : Nat) : Prop :=
  checkDistGE gens d = true

