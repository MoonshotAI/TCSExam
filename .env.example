# Copy to .env (ignored by Git), then load explicitly with set -a; source .env; set +a.
# The CLI never loads this file automatically. Never commit real credentials.
TCSEXAM_AGENT=kimi-code
TCSEXAM_API_KEY=
# Blank uses the selected agent/provider native endpoint. Custom URLs must use
# its compatible protocol (Kimi: OpenAI-compatible; Claude: Anthropic; Codex: Responses).
TCSEXAM_API_BASE_URL=
# Only Kimi has a default (kimi-k3). Set an explicit model for all other agents.
TCSEXAM_MODEL=
# Optional exact CLI pin. Unset: Kimi 0.43.0, others Harbor reuse/install policy.
TCSEXAM_AGENT_VERSION=
TCSEXAM_REASONING_EFFORT=
# Kimi only; default 1048576. Other agents use their own model context handling.
TCSEXAM_MAX_CONTEXT_TOKENS=
# Claude only; optional. A token/turn cap can finish before the 12-hour clock.
TCSEXAM_MAX_OUTPUT_TOKENS=
# Claude Code or Grok Build only; no default turn cap is added by TCSExam.
TCSEXAM_MAX_TURNS=
# Grok custom endpoint: responses, chat_completions or messages. A custom xAI
# endpoint requires this; known openai/anthropic/openrouter prefixes infer it.
TCSEXAM_GROK_API_BACKEND=
# If TCSEXAM_API_KEY is unset, the selected agent also accepts its native key:
# KIMI_MODEL_API_KEY (or KIMI_API_KEY/MOONSHOT_API_KEY), ANTHROPIC_API_KEY,
# OPENAI_API_KEY; Grok: XAI_API_KEY or the known provider-prefix key.

# Optional Online Solver backend; separate from model-provider settings.
TCSEXAM_BASE_URL=
TCSEXAM_TOKEN_ID=
TCSEXAM_TOKEN_SECRET=
# The CLI generates a distinct value per attempt; direct Harbor users must set it.
TCSEXAM_RUN_ID=
TCSEXAM_AGENT_NAME=
# Verifier only. Generated configs contain a placeholder, never the actual value.
TCSEXAM_ARCHIVE_TOKEN=
TCSEXAM_JUDGE_IMAGE=
# Empty or unset uses $HOME/.cache/tcsexam. Docker layers use Docker's storage.
TCSEXAM_CACHE=
